#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <c10/util/Half.h>

#define CHUNK_SIZE 4096
#define TASK_NUM 64

__mlu_entry__ void mse_loss_half_kernel(const half *predictions,
                                        const half *targets,
                                        float *partials,
                                        int total) {
  uint32_t core_id = taskId;
  uint32_t core_num = taskDim;
  uint32_t per_core = total / core_num;
  uint32_t remainder = total % core_num;
  uint32_t start = core_id * per_core + (core_id < remainder ? core_id : remainder);
  uint32_t count = per_core + (core_id < remainder ? 1 : 0);

  __nram__ half nram_pred_h[CHUNK_SIZE];
  __nram__ half nram_target_h[CHUNK_SIZE];
  __nram__ float nram_pred[CHUNK_SIZE];
  __nram__ float nram_target[CHUNK_SIZE];
  __nram__ float nram_reduce[CHUNK_SIZE];

  float local_sum = 0.0f;
  for (uint32_t offset = 0; offset < count; offset += CHUNK_SIZE) {
    uint32_t len = (offset + CHUNK_SIZE <= count) ? CHUNK_SIZE : (count - offset);
    uint32_t aligned_len = (len + 63) & ~63;

    __bang_write_value(nram_pred_h, aligned_len, (half)0);
    __bang_write_value(nram_target_h, aligned_len, (half)0);
    __memcpy(nram_pred_h, predictions + start + offset, len * sizeof(half), GDRAM2NRAM);
    __memcpy(nram_target_h, targets + start + offset, len * sizeof(half), GDRAM2NRAM);

    __bang_half2float(nram_pred, nram_pred_h, aligned_len);
    __bang_half2float(nram_target, nram_target_h, aligned_len);
    __bang_sub(nram_reduce, nram_pred, nram_target, aligned_len);
    __bang_square(nram_reduce, nram_reduce, aligned_len);
    __bang_sum(nram_reduce, nram_reduce, aligned_len);
    local_sum += nram_reduce[0];
  }
  partials[core_id] = local_sum;
}

__mlu_entry__ void mse_loss_float_kernel(const float *predictions,
                                         const float *targets,
                                         float *partials,
                                         int total) {
  uint32_t core_id = taskId;
  uint32_t core_num = taskDim;
  uint32_t per_core = total / core_num;
  uint32_t remainder = total % core_num;
  uint32_t start = core_id * per_core + (core_id < remainder ? core_id : remainder);
  uint32_t count = per_core + (core_id < remainder ? 1 : 0);

  __nram__ float nram_pred[CHUNK_SIZE];
  __nram__ float nram_target[CHUNK_SIZE];
  __nram__ float nram_reduce[CHUNK_SIZE];

  float local_sum = 0.0f;
  for (uint32_t offset = 0; offset < count; offset += CHUNK_SIZE) {
    uint32_t len = (offset + CHUNK_SIZE <= count) ? CHUNK_SIZE : (count - offset);
    uint32_t aligned_len = (len + 63) & ~63;

    __bang_write_value(nram_pred, aligned_len, 0.0f);
    __bang_write_value(nram_target, aligned_len, 0.0f);
    __memcpy(nram_pred, predictions + start + offset, len * sizeof(float), GDRAM2NRAM);
    __memcpy(nram_target, targets + start + offset, len * sizeof(float), GDRAM2NRAM);

    __bang_sub(nram_reduce, nram_pred, nram_target, aligned_len);
    __bang_square(nram_reduce, nram_reduce, aligned_len);
    __bang_sum(nram_reduce, nram_reduce, aligned_len);
    local_sum += nram_reduce[0];
  }
  partials[core_id] = local_sum;
}

__mlu_entry__ void finalize_mean_kernel(const float *partials, float *output,
                                        int total) {
  __nram__ float nram_partials[TASK_NUM];
  __bang_write_value(nram_partials, TASK_NUM, 0.0f);
  __memcpy(nram_partials, partials, TASK_NUM * sizeof(float), GDRAM2NRAM);
  __bang_sum(nram_partials, nram_partials, TASK_NUM);
  output[0] = nram_partials[0] / (float)total;
}

torch::Tensor bang_func(torch::Tensor predictions, torch::Tensor targets) {
  TORCH_CHECK(predictions.is_contiguous() && targets.is_contiguous(),
              "Inputs must be contiguous");
  TORCH_CHECK(predictions.numel() == targets.numel(),
              "Inputs must have the same number of elements");

  int total = static_cast<int>(predictions.numel());
  auto partials = torch::empty({TASK_NUM}, predictions.options().dtype(torch::kFloat));
  auto output = torch::empty({}, predictions.options().dtype(torch::kFloat));

  cnrtQueue_t queue = torch_mlu::getCurMLUStream();
  cnrtDim3_t dim = {TASK_NUM, 1, 1};
  cnrtDim3_t one = {1, 1, 1};
  cnrtFunctionType_t ktype = cnrtFuncTypeBlock;

  if (predictions.scalar_type() == torch::kHalf) {
    mse_loss_half_kernel<<<dim, ktype, queue>>>(
        reinterpret_cast<const half *>(predictions.data_ptr<c10::Half>()),
        reinterpret_cast<const half *>(targets.data_ptr<c10::Half>()),
        partials.data_ptr<float>(), total);
  } else {
    TORCH_CHECK(predictions.scalar_type() == torch::kFloat,
                "Only float16/float32 inputs are supported");
    mse_loss_float_kernel<<<dim, ktype, queue>>>(
        predictions.data_ptr<float>(), targets.data_ptr<float>(),
        partials.data_ptr<float>(), total);
  }

  finalize_mean_kernel<<<one, ktype, queue>>>(partials.data_ptr<float>(),
                                             output.data_ptr<float>(), total);
  return output;
}
