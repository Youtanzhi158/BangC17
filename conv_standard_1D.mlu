#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <c10/util/Half.h>

#define TASK_NUM 64

__mlu_entry__ void conv1d_half_kernel(const half *x, const half *kernel,
                                      half *out, int total, int batch,
                                      int in_channels, int out_channels,
                                      int kernel_size, int length,
                                      int out_length, int stride, int padding,
                                      int dilation, int groups) {
  int tid = taskId;
  int step = taskDim;
  int in_per_group = in_channels / groups;
  int out_per_group = out_channels / groups;

  for (int idx = tid; idx < total; idx += step) {
    int ow = idx % out_length;
    int tmp = idx / out_length;
    int oc = tmp % out_channels;
    int b = tmp / out_channels;
    int group = oc / out_per_group;
    int ic_begin = group * in_per_group;
    float sum = 0.0f;

    for (int icg = 0; icg < in_per_group; ++icg) {
      int ic = ic_begin + icg;
      for (int kw = 0; kw < kernel_size; ++kw) {
        int iw = ow * stride - padding + kw * dilation;
        if (iw >= 0 && iw < length) {
          float xv = (float)x[(b * in_channels + ic) * length + iw];
          float kv = (float)kernel[(oc * in_per_group + icg) * kernel_size + kw];
          sum += xv * kv;
        }
      }
    }
    out[idx] = (half)sum;
  }
}

torch::Tensor bang_func(torch::Tensor x, torch::Tensor kernel, int in_channels,
                        int out_channels, int kernel_size, int stride = 1,
                        int padding = 0, int dilation = 1, int groups = 1,
                        int bias = 0) {
  TORCH_CHECK(x.is_contiguous() && kernel.is_contiguous(), "Inputs must be contiguous");
  TORCH_CHECK(x.scalar_type() == torch::kHalf && kernel.scalar_type() == torch::kHalf,
              "Only float16 inputs are supported");
  int batch = static_cast<int>(x.size(0));
  int length = static_cast<int>(x.size(2));
  int out_length = (length + 2 * padding - dilation * (kernel_size - 1) - 1) / stride + 1;
  auto output = torch::empty({batch, out_channels, out_length}, x.options());
  int total = batch * out_channels * out_length;
  cnrtQueue_t queue = torch_mlu::getCurMLUStream();
  cnrtDim3_t grid = {TASK_NUM, 1, 1};
  conv1d_half_kernel<<<grid, cnrtFuncTypeBlock, queue>>>(
      reinterpret_cast<const half *>(x.data_ptr<c10::Half>()),
      reinterpret_cast<const half *>(kernel.data_ptr<c10::Half>()),
      reinterpret_cast<half *>(output.data_ptr<c10::Half>()), total, batch,
      in_channels, out_channels, kernel_size, length, out_length, stride,
      padding, dilation, groups);
  return output;
}
