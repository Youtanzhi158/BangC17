#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <c10/util/Half.h>
#include <vector>

#define INPUT_HEIGHT 256
#define INPUT_WIDTH 256
#define OUTPUT_HEIGHT 8
#define OUTPUT_WIDTH 8
#define POOL_KERNEL 32
#define POOL_TASKS 64

__mlu_entry__ void adaptive_max_pool_2d_half_kernel(
    const half *input,
    half *output,
    int total_planes) {
  if (__is_mpu()) {
    return;
  }

  const int input_plane = INPUT_HEIGHT * INPUT_WIDTH;
  const int output_plane = OUTPUT_HEIGHT * OUTPUT_WIDTH;

  __nram__ half nram_input[2 * INPUT_HEIGHT * INPUT_WIDTH];
  __nram__ half nram_output[2 * OUTPUT_HEIGHT * OUTPUT_WIDTH];

  int plane_count = 0;
  if (taskId < total_planes) {
    plane_count = (total_planes - 1 - taskId) / taskDim + 1;
  }
  if (plane_count == 0) {
    return;
  }

  __memcpy_async(
      nram_input,
      input + taskId * input_plane,
      input_plane * sizeof(half),
      GDRAM2NRAM);
  __asm__ volatile("sync;");

  for (int index = 0; index < plane_count; ++index) {
    int current = index & 1;
    int plane = taskId + index * taskDim;
    int next_plane = plane + taskDim;

    if (index + 1 < plane_count) {
      __memcpy_async(
          nram_input + (1 - current) * input_plane,
          input + next_plane * input_plane,
          input_plane * sizeof(half),
          GDRAM2NRAM);
    }
    __bang_maxpool(
        nram_output + current * output_plane,
        nram_input + current * input_plane,
        1,
        INPUT_HEIGHT,
        INPUT_WIDTH,
        POOL_KERNEL,
        POOL_KERNEL);
    __asm__ volatile("sync;");

    __memcpy_async(
        output + plane * output_plane,
        nram_output + current * output_plane,
        output_plane * sizeof(half),
        NRAM2GDRAM);
  }
  __asm__ volatile("sync;");
}

torch::Tensor bang_func(
    torch::Tensor x,
    std::vector<int64_t> output_size) {
  TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
  TORCH_CHECK(x.scalar_type() == torch::kHalf,
              "Only float16 input is supported");
  TORCH_CHECK(x.dim() == 4, "Input must have shape [N, C, H, W]");
  TORCH_CHECK(x.size(2) == INPUT_HEIGHT && x.size(3) == INPUT_WIDTH,
              "Only 256x256 input is supported");
  TORCH_CHECK(output_size.size() == 2 &&
                  output_size[0] == OUTPUT_HEIGHT &&
                  output_size[1] == OUTPUT_WIDTH,
              "Only output_size=(8, 8) is supported");

  int batch = static_cast<int>(x.size(0));
  int channels = static_cast<int>(x.size(1));
  auto output = torch::empty(
      {batch, channels, OUTPUT_HEIGHT, OUTPUT_WIDTH},
      x.options());

  cnrtQueue_t queue = torch_mlu::getCurMLUStream();
  cnrtDim3_t grid = {POOL_TASKS, 1, 1};
  adaptive_max_pool_2d_half_kernel<<<grid, cnrtFuncTypeBlock, queue>>>(
      reinterpret_cast<const half *>(x.data_ptr<c10::Half>()),
      reinterpret_cast<half *>(output.data_ptr<c10::Half>()),
      batch * channels);
  return output;
}
