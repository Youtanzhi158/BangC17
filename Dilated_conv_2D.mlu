#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <c10/util/Half.h>

#define TASK_NUM 64

__mlu_entry__ void dilated_conv2d_half_kernel(const half *x, const half *kernel,
                                              half *out, int total, int batch,
                                              int in_channels,
                                              int out_channels, int height,
                                              int width, int kernel_size,
                                              int dilation, int padding,
                                              int out_h, int out_w) {
  for (int idx = taskId; idx < total; idx += taskDim) {
    int ow = idx % out_w;
    int tmp = idx / out_w;
    int oh = tmp % out_h;
    tmp /= out_h;
    int oc = tmp % out_channels;
    int b = tmp / out_channels;

    float sum = 0.0f;
    for (int ic = 0; ic < in_channels; ++ic) {
      for (int kh = 0; kh < kernel_size; ++kh) {
        int ih = oh - padding + kh * dilation;
        if (ih < 0 || ih >= height) continue;
        for (int kw = 0; kw < kernel_size; ++kw) {
          int iw = ow - padding + kw * dilation;
          if (iw < 0 || iw >= width) continue;
          float xv = (float)x[((b * in_channels + ic) * height + ih) * width + iw];
          float kv = (float)kernel[((oc * in_channels + ic) * kernel_size + kh) *
                                       kernel_size +
                                   kw];
          sum += xv * kv;
        }
      }
    }
    out[idx] = (half)sum;
  }
}

torch::Tensor bang_func(torch::Tensor x, torch::Tensor kernel, int in_channels,
                        int out_channels, int kernel_size, int dilation,
                        int padding) {
  TORCH_CHECK(x.is_contiguous() && kernel.is_contiguous(), "Inputs must be contiguous");
  TORCH_CHECK(x.scalar_type() == torch::kHalf && kernel.scalar_type() == torch::kHalf,
              "Only float16 inputs are supported");
  int batch = static_cast<int>(x.size(0));
  int height = static_cast<int>(x.size(2));
  int width = static_cast<int>(x.size(3));
  int out_h = height + 2 * padding - dilation * (kernel_size - 1);
  int out_w = width + 2 * padding - dilation * (kernel_size - 1);
  auto output = torch::empty({batch, out_channels, out_h, out_w}, x.options());
  int total = batch * out_channels * out_h * out_w;
  cnrtQueue_t queue = torch_mlu::getCurMLUStream();
  cnrtDim3_t grid = {TASK_NUM, 1, 1};
  dilated_conv2d_half_kernel<<<grid, cnrtFuncTypeBlock, queue>>>(
      reinterpret_cast<const half *>(x.data_ptr<c10::Half>()),
      reinterpret_cast<const half *>(kernel.data_ptr<c10::Half>()),
      reinterpret_cast<half *>(output.data_ptr<c10::Half>()), total, batch,
      in_channels, out_channels, height, width, kernel_size, dilation, padding,
      out_h, out_w);
  return output;
}
