#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <c10/util/Half.h>

#define ROWS 16
#define COLS 16384
#define LN2 0.6931471805599453f

__mlu_entry__ void logsoftmax_half_kernel(const half *x, half *out, int rows,
                                          int cols) {
  int row = taskId;
  if (row >= rows) return;

  __nram__ half nram_h[COLS];
  __nram__ float nram_x[COLS];
  __nram__ float nram_tmp[COLS];
  __nram__ float nram_reduce[64];

  const int aligned_cols = (cols + 63) & ~63;
  __memcpy(nram_h, x + row * cols, cols * sizeof(half), GDRAM2NRAM);
  __bang_half2float(nram_x, nram_h, aligned_cols);

  __bang_argmax(nram_reduce, nram_x, aligned_cols);
  float max_val = nram_reduce[0];

  __bang_sub_scalar(nram_tmp, nram_x, max_val, aligned_cols);
  __bang_active_exphp(nram_tmp, nram_tmp, aligned_cols);
  __bang_sum(nram_reduce, nram_tmp, aligned_cols);
  __bang_write_value(nram_reduce, 64, nram_reduce[0]);
  __bang_log2(nram_reduce, nram_reduce, 64);
  float log_sum = nram_reduce[0] * LN2;

  __bang_sub_scalar(nram_x, nram_x, max_val + log_sum, aligned_cols);
  __bang_float2half_rd(nram_h, nram_x, aligned_cols);
  __memcpy(out + row * cols, nram_h, cols * sizeof(half), NRAM2GDRAM);
}

torch::Tensor bang_func(torch::Tensor x, int dim) {
  TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
  TORCH_CHECK(dim == 1 || dim == -1, "Only dim=1/-1 is supported");
  TORCH_CHECK(x.scalar_type() == torch::kHalf, "Only float16 input is supported");
  auto output = torch::empty_like(x);
  int rows = static_cast<int>(x.size(0));
  int cols = static_cast<int>(x.size(1));
  cnrtQueue_t queue = torch_mlu::getCurMLUStream();
  cnrtDim3_t grid = {static_cast<unsigned int>(rows), 1, 1};
  logsoftmax_half_kernel<<<grid, cnrtFuncTypeBlock, queue>>>(
      reinterpret_cast<const half *>(x.data_ptr<c10::Half>()),
      reinterpret_cast<half *>(output.data_ptr<c10::Half>()), rows, cols);
  return output;
}
