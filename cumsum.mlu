#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <c10/util/Half.h>

#define TASK_NUM 128

__mlu_entry__ void cumsum_dim1_half_kernel(const half *x, float *out,
                                           int rows, int cols) {
  for (int row = taskId; row < rows; row += taskDim) {
    float sum = 0.0f;
    for (int col = 0; col < cols; ++col) {
      int idx = row * cols + col;
      sum += (float)x[idx];
      out[idx] = sum;
    }
  }
}

torch::Tensor bang_func(torch::Tensor x, int dim) {
  TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
  TORCH_CHECK(x.scalar_type() == torch::kHalf, "Only float16 input is supported");
  TORCH_CHECK(dim == 1 || dim == -1, "Only dim=1/-1 is supported");
  int rows = static_cast<int>(x.size(0));
  int cols = static_cast<int>(x.size(1));
  auto output = torch::empty({rows, cols}, x.options().dtype(torch::kFloat));
  cnrtQueue_t queue = torch_mlu::getCurMLUStream();
  cnrtDim3_t grid = {TASK_NUM, 1, 1};
  cumsum_dim1_half_kernel<<<grid, cnrtFuncTypeBlock, queue>>>(
      reinterpret_cast<const half *>(x.data_ptr<c10::Half>()),
      output.data_ptr<float>(), rows, cols);
  return output;
}
