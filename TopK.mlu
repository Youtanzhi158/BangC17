#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <c10/util/Half.h>
#include <vector>
#include <cstdint>

#define TASK_NUM 16
#define MAX_K 16

__mlu_entry__ void topk_dim1_half_kernel(const half *x, half *values,
                                         int64_t *indices, int rows, int cols,
                                         int k) {
  int row = taskId;
  if (row >= rows) return;

  float best_vals[MAX_K];
  int best_idx[MAX_K];
  for (int t = 0; t < k; ++t) {
    best_vals[t] = -3.402823466e38f;
    best_idx[t] = 0;
  }

  for (int col = 0; col < cols; ++col) {
    float v = (float)x[row * cols + col];
    for (int t = 0; t < k; ++t) {
      if (v > best_vals[t]) {
        for (int s = k - 1; s > t; --s) {
          best_vals[s] = best_vals[s - 1];
          best_idx[s] = best_idx[s - 1];
        }
        best_vals[t] = v;
        best_idx[t] = col;
        break;
      }
    }
  }

  for (int t = 0; t < k; ++t) {
    values[row * k + t] = (half)best_vals[t];
    indices[row * k + t] = (int64_t)best_idx[t];
  }
}

std::vector<torch::Tensor> bang_func(torch::Tensor x, int k, int dim) {
  TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
  TORCH_CHECK(x.scalar_type() == torch::kHalf, "Only float16 input is supported");
  TORCH_CHECK(dim == 1 && k <= MAX_K, "Only dim=1 and k<=16 are supported");
  int rows = static_cast<int>(x.size(0));
  int cols = static_cast<int>(x.size(1));
  auto values = torch::empty({rows, k}, x.options());
  auto indices = torch::empty({rows, k}, x.options().dtype(torch::kInt64));
  cnrtQueue_t queue = torch_mlu::getCurMLUStream();
  cnrtDim3_t grid = {static_cast<unsigned int>(rows), 1, 1};
  topk_dim1_half_kernel<<<grid, cnrtFuncTypeBlock, queue>>>(
      reinterpret_cast<const half *>(x.data_ptr<c10::Half>()),
      reinterpret_cast<half *>(values.data_ptr<c10::Half>()),
      indices.data_ptr<int64_t>(), rows, cols, k);
  return {values, indices};
}
