#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <c10/util/Half.h>

// 分块参数
#define TILE_H 2
#define TILE_W 64
#define TASK_NUM 256

__mlu_entry__ void grouped_conv2d_kernel(
    half *out, const half *x, const half *kernel_h,
    int total_tiles, int in_channels, int out_channels,
    int height, int width, int kernel_size, int groups,
    int padding, int out_h, int out_w) {

  int icpg = in_channels / groups;
  int ocpg = out_channels / groups;
  int num_w_tiles = (out_w + TILE_W - 1) / TILE_W;
  int num_h_tiles = (out_h + TILE_H - 1) / TILE_H;
  int k_sq = kernel_size * kernel_size;
  int filter_elems = ocpg * icpg * k_sq;

  // NRAM 缓冲区
  int max_in_h = TILE_H + kernel_size - 1;
  int max_in_w = TILE_W + kernel_size - 1;
  int in_buf_size = max_in_h * max_in_w * icpg;
  int out_buf_size = TILE_H * TILE_W * ocpg;

  __nram__ float nram_in[4 * 66 * 8];    // max_in_h * max_in_w * max_icpg
  __nram__ float nram_out[2 * 64 * 16];   // TILE_H * TILE_W * max_ocpg
  __nram__ half nram_flt_half[16 * 8 * 9]; // max_ocpg * max_icpg * max_k_sq
  __nram__ float nram_flt_nchw[16 * 8 * 9];
  __nram__ float nram_flt_nhwc[16 * 9 * 8]; // max_ocpg * max_k_sq * max_icpg
  __wram__ float wram_flt[16 * 9 * 8];

  for (int tile = taskId; tile < total_tiles; tile += taskDim) {
    int tmp = tile;
    int tw = tmp % num_w_tiles; tmp /= num_w_tiles;
    int th = tmp % num_h_tiles; tmp /= num_h_tiles;
    int g  = tmp % groups;      tmp /= groups;
    int b  = tmp;

    int oh_start = th * TILE_H;
    int oh_end = oh_start + TILE_H;
    if (oh_end > out_h) oh_end = out_h;
    int actual_h = oh_end - oh_start;
    if (actual_h <= 0) continue;

    int ow_start = tw * TILE_W;
    int ow_end = ow_start + TILE_W;
    if (ow_end > out_w) ow_end = out_w;
    int actual_w = ow_end - ow_start;
    if (actual_w <= 0) continue;

    int ih_start = oh_start - padding;
    int ih_end = oh_start + actual_h - 1 + kernel_size - padding;
    int iw_start = ow_start - padding;
    int iw_end = ow_start + actual_w - 1 + kernel_size - padding;
    int in_h = ih_end - ih_start;
    int in_w = iw_end - iw_start;

    // 1. 加载输入到 NRAM（HWC 布局），边界补零
    __bang_write_value(nram_in, in_h * in_w * icpg, 0.0f);

    int r_start = ih_start < 0 ? 0 : ih_start;
    int r_end = ih_end > height ? height : ih_end;
    int c_start = iw_start < 0 ? 0 : iw_start;
    int c_end = iw_end > width ? width : iw_end;

    for (int r = r_start; r < r_end; ++r) {
      for (int c = c_start; c < c_end; ++c) {
        for (int ic = 0; ic < icpg; ++ic) {
          nram_in[((r - ih_start) * in_w + (c - iw_start)) * icpg + ic] =
              (float)x[((b * in_channels + g * icpg + ic) * height + r) * width + c];
        }
      }
    }

    // 2. 加载 filter: GDRAM(half NCHW) → NRAM → WRAM(float NHWC)
    __memcpy(nram_flt_half, kernel_h + g * ocpg * icpg * k_sq,
             filter_elems * sizeof(half), GDRAM2NRAM);
    __bang_half2float(nram_flt_nchw, nram_flt_half, filter_elems);

    // 重排 NCHW → NHWC
    for (int oc = 0; oc < ocpg; ++oc) {
      for (int kh = 0; kh < kernel_size; ++kh) {
        for (int kw = 0; kw < kernel_size; ++kw) {
          for (int ic = 0; ic < icpg; ++ic) {
            nram_flt_nhwc[(oc * k_sq + kh * kernel_size + kw) * icpg + ic] =
                nram_flt_nchw[(oc * icpg + ic) * k_sq + kh * kernel_size + kw];
          }
        }
      }
    }

    __memcpy(wram_flt, nram_flt_nhwc, filter_elems * sizeof(float), NRAM2WRAM);

    // 3. 调用 __bang_conv
    __bang_conv(nram_out, nram_in, wram_flt,
                icpg, in_h, in_w,
                kernel_size, kernel_size,
                1, 1, ocpg);

    // 4. 输出 HWC → NCHW 写回 GDRAM
    for (int oh = 0; oh < actual_h; ++oh) {
      for (int ow = 0; ow < actual_w; ++ow) {
        for (int oc = 0; oc < ocpg; ++oc) {
          out[((b * out_channels + g * ocpg + oc) * out_h + oh_start + oh) * out_w + ow_start + ow] =
              (half)nram_out[(oh * actual_w + ow) * ocpg + oc];
        }
      }
    }
  }
}

torch::Tensor bang_func(torch::Tensor x, torch::Tensor kernel,
                        int in_channels, int out_channels,
                        int kernel_size, int groups) {
  TORCH_CHECK(x.is_contiguous() && kernel.is_contiguous(),
              "Inputs must be contiguous");
  TORCH_CHECK(x.scalar_type() == torch::kHalf &&
                  kernel.scalar_type() == torch::kHalf,
              "Only float16 inputs are supported");

  int batch = static_cast<int>(x.size(0));
  int height = static_cast<int>(x.size(2));
  int width = static_cast<int>(x.size(3));
  int padding = kernel_size / 2;
  int out_h = height;
  int out_w = width;

  auto output = torch::empty({batch, out_channels, out_h, out_w},
                             x.options().dtype(torch::kHalf));

  int num_w_tiles = (out_w + TILE_W - 1) / TILE_W;
  int num_h_tiles = (out_h + TILE_H - 1) / TILE_H;
  int total_tiles = batch * groups * num_h_tiles * num_w_tiles;

  cnrtQueue_t queue = torch_mlu::getCurMLUStream();
  cnrtDim3_t grid = {TASK_NUM, 1, 1};
  grouped_conv2d_kernel<<<grid, cnrtFuncTypeBlock, queue>>>(
      reinterpret_cast<half *>(output.data_ptr<c10::Half>()),
      reinterpret_cast<const half *>(x.data_ptr<c10::Half>()),
      reinterpret_cast<const half *>(kernel.data_ptr<c10::Half>()),
      total_tiles, in_channels, out_channels, height, width,
      kernel_size, groups, padding, out_h, out_w);
  return output;
}
