#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <c10/util/Half.h>

#define TILE 32768
#define TASKS 16

__mlu_entry__ void hadamard_half_kernel(half *a, const half *b, int total) {
  int per_core = total / taskDim;
  int rem = total % taskDim;
  int start = taskId * per_core + (taskId < rem ? taskId : rem);
  int count = per_core + (taskId < rem ? 1 : 0);
  __nram__ half left[TILE];
  __nram__ half right[TILE];

  for (int offset = 0; offset < count; offset += TILE) {
    int len = count - offset;
    if (len > TILE) len = TILE;
    int aligned = (len + 63) & ~63;
    __memcpy(left, a + start + offset, len * sizeof(half), GDRAM2NRAM);
    __memcpy(right, b + start + offset, len * sizeof(half), GDRAM2NRAM);
    __bang_mul(left, left, right, aligned);
    __memcpy(a + start + offset, left, len * sizeof(half), NRAM2GDRAM);
  }
}

torch::Tensor bang_func(torch::Tensor A, torch::Tensor B) {
  TORCH_CHECK(A.is_contiguous() && B.is_contiguous(),
              "Inputs must be contiguous");
  TORCH_CHECK(A.scalar_type() == torch::kHalf &&
                  B.scalar_type() == torch::kHalf &&
                  A.sizes() == B.sizes(),
              "Inputs must be matching float16 tensors");
  cnrtQueue_t queue = torch_mlu::getCurMLUStream();
  cnrtDim3_t grid = {TASKS, 1, 1};
  hadamard_half_kernel<<<grid, cnrtFuncTypeBlock, queue>>>(
      reinterpret_cast<half *>(A.data_ptr<c10::Half>()),
      reinterpret_cast<const half *>(B.data_ptr<c10::Half>()),
      static_cast<int>(A.numel()));
  return A;
}
