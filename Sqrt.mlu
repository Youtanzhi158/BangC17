#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <c10/util/Half.h>

#define TASK_NUM 64

__mlu_func__ float sqrt_newton(float v) {
  if (v <= 0.0f) return 0.0f;
  float y = v > 1.0f ? v : 1.0f;
  for (int i = 0; i < 8; ++i) {
    y = 0.5f * (y + v / y);
  }
  return y;
}

__mlu_entry__ void sqrt_abs_half_kernel(const half *input, float *output, int total) {
  for (int idx = taskId; idx < total; idx += taskDim) {
    float v = (float)input[idx];
    if (v < 0.0f) v = -v;
    output[idx] = sqrt_newton(v);
  }
}

torch::Tensor bang_func(torch::Tensor x) {
  TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
  TORCH_CHECK(x.scalar_type() == torch::kHalf, "Only float16 input is supported");
  auto output = torch::empty(x.sizes(), x.options().dtype(torch::kFloat));

  int total = static_cast<int>(x.numel());
  cnrtQueue_t queue = torch_mlu::getCurMLUStream();
  cnrtDim3_t dim = {TASK_NUM, 1, 1};
  sqrt_abs_half_kernel<<<dim, cnrtFuncTypeBlock, queue>>>(
      reinterpret_cast<const half *>(x.data_ptr<c10::Half>()),
      output.data_ptr<float>(), total);

  return output;
}
