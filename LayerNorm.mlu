#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <c10/util/Half.h>

#define LAYER_NORM_WIDTH 512
#define LAYER_NORM_TASKS 16
#define LAYER_NORM_EPS 1.0e-5f

__mlu_entry__ void layer_norm_half_kernel(
    half *x,
    int rows,
    int cols) {
  if (__is_mpu()) {
    return;
  }

  __nram__ half nram_half[LAYER_NORM_WIDTH];
  __nram__ float nram_value[LAYER_NORM_WIDTH];
  __nram__ float nram_centered[LAYER_NORM_WIDTH];
  __nram__ float nram_reduce[64];

  for (int row = taskId; row < rows; row += taskDim) {
    half *row_ptr = x + row * cols;
    __memcpy(nram_half, row_ptr, cols * sizeof(half), GDRAM2NRAM);
    __bang_half2float(nram_value, nram_half, cols);

    __bang_sum(nram_reduce, nram_value, cols);
    float mean = nram_reduce[0] * (1.0f / (float)LAYER_NORM_WIDTH);

    __bang_sub_scalar(nram_centered, nram_value, mean, cols);
    __bang_mul(nram_value, nram_centered, nram_centered, cols);
    __bang_sum(nram_reduce, nram_value, cols);
    float variance =
        nram_reduce[0] * (1.0f / (float)LAYER_NORM_WIDTH);

    __bang_write_value(nram_reduce, 64, variance + LAYER_NORM_EPS);
    __bang_sqrt(nram_reduce, nram_reduce, 64);
    float inv_std = 1.0f / nram_reduce[0];

    __bang_mul_scalar(nram_centered, nram_centered, inv_std, cols);
    __bang_float2half_rn(nram_half, nram_centered, cols);
    __memcpy(row_ptr, nram_half, cols * sizeof(half), NRAM2GDRAM);
  }
}

torch::Tensor bang_func(
    torch::Tensor x,
    torch::Tensor weight,
    torch::Tensor bias,
    int normalized_shape) {
  TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
  TORCH_CHECK(weight.is_contiguous(), "Weight must be contiguous");
  TORCH_CHECK(bias.is_contiguous(), "Bias must be contiguous");
  TORCH_CHECK(x.scalar_type() == torch::kHalf,
              "Only float16 input is supported");
  TORCH_CHECK(weight.scalar_type() == torch::kHalf,
              "Only float16 weight is supported");
  TORCH_CHECK(bias.scalar_type() == torch::kHalf,
              "Only float16 bias is supported");
  TORCH_CHECK(normalized_shape == LAYER_NORM_WIDTH,
              "Only normalized_shape=512 is supported");

  int rows = static_cast<int>(x.numel() / normalized_shape);
  cnrtQueue_t queue = torch_mlu::getCurMLUStream();
  cnrtDim3_t grid = {LAYER_NORM_TASKS, 1, 1};
  layer_norm_half_kernel<<<grid, cnrtFuncTypeUnion1, queue>>>(
      reinterpret_cast<half *>(x.data_ptr<c10::Half>()),
      rows,
      normalized_shape);
  return x;
}
