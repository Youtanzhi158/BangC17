#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <c10/util/Half.h>

#define TASK_NUM 256
#define K_CHUNK 1024

__mlu_entry__ void bmm_half_kernel(const half *A, const half *B, float *C,
                                   int total, int batch, int m, int k, int n) {
  __nram__ half nram_a_h[K_CHUNK];
  __nram__ half nram_b_h[K_CHUNK];
  __nram__ float nram_a[K_CHUNK];
  __nram__ float nram_b[K_CHUNK];
  __nram__ float nram_prod[K_CHUNK];

  for (int idx = taskId; idx < total; idx += taskDim) {
    int col = idx % n;
    int tmp = idx / n;
    int row = tmp % m;
    int b = tmp / m;

    float sum = 0.0f;
    int a_base = (b * m + row) * k;
    int b_base = b * k * n + col;

    for (int ks = 0; ks < k; ks += K_CHUNK) {
      int len = k - ks;
      if (len > K_CHUNK) len = K_CHUNK;
      int aligned_len = (len + 63) & ~63;

      __bang_write_value(nram_a_h, aligned_len, (half)0);
      __bang_write_value(nram_b_h, aligned_len, (half)0);
      __memcpy(nram_a_h, A + a_base + ks, len * sizeof(half), GDRAM2NRAM);
      for (int i = 0; i < len; ++i) {
        nram_b_h[i] = B[b_base + (ks + i) * n];
      }

      __bang_half2float(nram_a, nram_a_h, aligned_len);
      __bang_half2float(nram_b, nram_b_h, aligned_len);
      __bang_mul(nram_prod, nram_a, nram_b, aligned_len);
      for (int i = 0; i < len; ++i) {
        sum += nram_prod[i];
      }
    }
    C[idx] = sum;
  }
}

torch::Tensor bang_func(torch::Tensor A, torch::Tensor B) {
  TORCH_CHECK(A.is_contiguous() && B.is_contiguous(), "Inputs must be contiguous");
  TORCH_CHECK(A.scalar_type() == torch::kHalf && B.scalar_type() == torch::kHalf,
              "Only float16 inputs are supported");
  TORCH_CHECK(A.dim() == 3 && B.dim() == 3, "Inputs must be 3D tensors");
  int batch = static_cast<int>(A.size(0));
  int m = static_cast<int>(A.size(1));
  int k = static_cast<int>(A.size(2));
  int n = static_cast<int>(B.size(2));
  auto output = torch::empty({batch, m, n}, A.options().dtype(torch::kFloat));
  int total = batch * m * n;
  cnrtQueue_t queue = torch_mlu::getCurMLUStream();
  cnrtDim3_t grid = {TASK_NUM, 1, 1};
  bmm_half_kernel<<<grid, cnrtFuncTypeBlock, queue>>>(
      reinterpret_cast<const half *>(A.data_ptr<c10::Half>()),
      reinterpret_cast<const half *>(B.data_ptr<c10::Half>()),
      output.data_ptr<float>(), total, batch, m, k, n);
  return output;
}
