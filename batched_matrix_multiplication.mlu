#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <c10/util/Half.h>

#define M_TILE 16
#define N_TILE 128
#define K_TILE 128

__mlu_entry__ void bmm_half_kernel(const half *A, const half *B, float *C,
                                   int batch, int m, int k, int n) {
  __nram__ half nram_a[M_TILE * K_TILE];
  __nram__ half nram_b[K_TILE * N_TILE];
  __nram__ half nram_b_t[N_TILE * K_TILE];
  __nram__ float nram_c[M_TILE * N_TILE];
  __nram__ float nram_tmp[M_TILE * N_TILE];
  __wram__ half wram_b[N_TILE * K_TILE];

  int m_tiles = m / M_TILE;
  int n_tiles = n / N_TILE;
  int total_tiles = batch * m_tiles * n_tiles;

  for (int tile = taskId; tile < total_tiles; tile += taskDim) {
    int nt = tile % n_tiles;
    int tmp = tile / n_tiles;
    int mt = tmp % m_tiles;
    int b = tmp / m_tiles;

    int m_start = mt * M_TILE;
    int n_start = nt * N_TILE;
    __bang_write_value(nram_c, M_TILE * N_TILE, 0.0f);

    for (int k_start = 0; k_start < k; k_start += K_TILE) {
      const half *a_ptr = A + ((b * m + m_start) * k + k_start);
      const half *b_ptr = B + (b * k * n + k_start * n + n_start);

      for (int row = 0; row < M_TILE; ++row) {
        __memcpy(nram_a + row * K_TILE, a_ptr + row * k,
                 K_TILE * sizeof(half), GDRAM2NRAM);
      }
      for (int row = 0; row < K_TILE; ++row) {
        __memcpy(nram_b + row * N_TILE, b_ptr + row * n,
                 N_TILE * sizeof(half), GDRAM2NRAM);
      }
      __sync();

      __bang_transpose(nram_b_t, nram_b, K_TILE, N_TILE);
      __memcpy(wram_b, nram_b_t, N_TILE * K_TILE * sizeof(half), NRAM2WRAM);
      __bang_matmul(nram_tmp, nram_a, wram_b, M_TILE, K_TILE, N_TILE, 0);
      __bang_add(nram_c, nram_c, nram_tmp, M_TILE * N_TILE);
    }

    for (int row = 0; row < M_TILE; ++row) {
      __memcpy(C + ((b * m + m_start + row) * n + n_start),
               nram_c + row * N_TILE, N_TILE * sizeof(float), NRAM2GDRAM);
    }
  }
}

torch::Tensor bang_func(torch::Tensor A, torch::Tensor B) {
  TORCH_CHECK(A.is_contiguous() && B.is_contiguous(), "Inputs must be contiguous");
  TORCH_CHECK(A.scalar_type() == torch::kHalf && B.scalar_type() == torch::kHalf,
              "Only float16 inputs are supported");
  int batch = static_cast<int>(A.size(0));
  int m = static_cast<int>(A.size(1));
  int k = static_cast<int>(A.size(2));
  int n = static_cast<int>(B.size(2));
  auto output = torch::empty({batch, m, n}, A.options().dtype(torch::kFloat));
  cnrtQueue_t queue = torch_mlu::getCurMLUStream();
  cnrtDim3_t grid = {64, 1, 1};
  bmm_half_kernel<<<grid, cnrtFuncTypeBlock, queue>>>(
      reinterpret_cast<const half *>(A.data_ptr<c10::Half>()),
      reinterpret_cast<const half *>(B.data_ptr<c10::Half>()),
      output.data_ptr<float>(), batch, m, k, n);
  return output;
}
