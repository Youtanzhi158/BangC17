#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <c10/util/Half.h>

#define MAX_DIM1 256
#define MAX_DIM2 256

__mlu_entry__ void max_dim1_half_kernel(const half *input, half *output,
                                        int batch, int dim1, int dim2) {
  int batch_index = taskId;
  if (batch_index >= batch) return;

  __nram__ half nram_input[MAX_DIM1 * MAX_DIM2];
  __memcpy(nram_input, input + batch_index * dim1 * dim2,
           dim1 * dim2 * sizeof(half), GDRAM2NRAM);

  for (int column = 0; column < dim2; ++column) {
    half best = nram_input[column];
    for (int row = 1; row < dim1; ++row) {
      half value = nram_input[row * dim2 + column];
      if ((float)value > (float)best) best = value;
    }
    output[batch_index * dim2 + column] = best;
  }
}

torch::Tensor bang_func(torch::Tensor x, int dim) {
  TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
  TORCH_CHECK(x.scalar_type() == torch::kHalf,
              "Only float16 input is supported");
  TORCH_CHECK(x.dim() == 3, "Only 3D input is supported");
  TORCH_CHECK(dim == 1, "Only dim=1 is supported");

  int batch = static_cast<int>(x.size(0));
  int dim1 = static_cast<int>(x.size(1));
  int dim2 = static_cast<int>(x.size(2));
  TORCH_CHECK(dim1 <= MAX_DIM1 && dim2 <= MAX_DIM2,
              "Input shape exceeds the supported workload");

  auto output = torch::empty({batch, dim2}, x.options());
  cnrtQueue_t queue = torch_mlu::getCurMLUStream();
  cnrtDim3_t grid = {static_cast<unsigned int>(batch), 1, 1};
  max_dim1_half_kernel<<<grid, cnrtFuncTypeBlock, queue>>>(
      reinterpret_cast<const half *>(x.data_ptr<c10::Half>()),
      reinterpret_cast<half *>(output.data_ptr<c10::Half>()), batch, dim1,
      dim2);
  return output;
}
