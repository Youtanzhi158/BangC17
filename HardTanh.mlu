#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <c10/util/Half.h>

#define CHUNK_SIZE 16384
#define TASK_NUM 16

__mlu_entry__ void hard_tanh_half_kernel(const half *input, half *output,
                                          int total) {
  int core_id = taskId;
  int per_core = total / taskDim;
  int remainder = total % taskDim;
  int start = core_id * per_core + (core_id < remainder ? core_id : remainder);
  int count = per_core + (core_id < remainder ? 1 : 0);

  __nram__ half nram_input[CHUNK_SIZE];
  __nram__ half nram_temp[CHUNK_SIZE];
  __nram__ half nram_bound[CHUNK_SIZE];

  for (int offset = 0; offset < count; offset += CHUNK_SIZE) {
    int len = (offset + CHUNK_SIZE <= count) ? CHUNK_SIZE : count - offset;
    __memcpy(nram_input, input + start + offset, len * sizeof(half),
             GDRAM2NRAM);

    int aligned_len = (len + 63) & ~63;
    __bang_write_value(nram_bound, aligned_len, (half)-1.0f);
    __bang_maximum(nram_temp, nram_input, nram_bound, aligned_len);
    __bang_write_value(nram_bound, aligned_len, (half)1.0f);
    __bang_minimum(nram_input, nram_temp, nram_bound, aligned_len);

    __memcpy(output + start + offset, nram_input, len * sizeof(half),
             NRAM2GDRAM);
  }
}

torch::Tensor bang_func(torch::Tensor x) {
  TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
  TORCH_CHECK(x.scalar_type() == torch::kHalf,
              "Only float16 input is supported");

  auto output = torch::empty_like(x);
  int total = static_cast<int>(x.numel());
  cnrtQueue_t queue = torch_mlu::getCurMLUStream();
  cnrtDim3_t grid = {TASK_NUM, 1, 1};
  hard_tanh_half_kernel<<<grid, cnrtFuncTypeBlock, queue>>>(
      reinterpret_cast<const half *>(x.data_ptr<c10::Half>()),
      reinterpret_cast<half *>(output.data_ptr<c10::Half>()), total);
  return output;
}
