#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <c10/util/Half.h>
#include <cstdint>

#define TASK_NUM 64

__mlu_entry__ void gather_half_kernel(const half *x, const int32_t *indices,
                                      const int32_t *bin_ids,
                                      const half *weights,
                                      const int32_t *bins, half *out,
                                      int elements, int hidden_size,
                                      int top_k) {
  int total = elements * hidden_size;
  for (int flat = taskId; flat < total; flat += taskDim) {
    int e = flat / hidden_size;
    int h = flat % hidden_size;
    int bin = bin_ids[e];
    int bin_start = (bin == 0) ? 0 : bins[bin - 1];
    int index_b = e - bin_start + bin_start;
    int src_row = indices[e] / top_k;
    float val = (float)x[src_row * hidden_size + h] * (float)weights[indices[e]];
    out[index_b * hidden_size + h] = (half)val;
  }
}

torch::Tensor bang_func(torch::Tensor x, torch::Tensor indices,
                        torch::Tensor bin_ids, torch::Tensor weights,
                        torch::Tensor bins, int top_k) {
  TORCH_CHECK(x.is_contiguous() && indices.is_contiguous() && bin_ids.is_contiguous() &&
                  weights.is_contiguous() && bins.is_contiguous(),
              "Inputs must be contiguous");
  int tokens = static_cast<int>(x.size(0));
  int hidden_size = static_cast<int>(x.size(1));
  int elements = static_cast<int>(indices.numel());
  auto output = torch::empty({tokens * top_k, hidden_size}, x.options());
  cnrtQueue_t queue = torch_mlu::getCurMLUStream();
  cnrtDim3_t grid = {TASK_NUM, 1, 1};
  gather_half_kernel<<<grid, cnrtFuncTypeBlock, queue>>>(
      reinterpret_cast<const half *>(x.data_ptr<c10::Half>()),
      indices.data_ptr<int32_t>(), bin_ids.data_ptr<int32_t>(),
      reinterpret_cast<const half *>(weights.data_ptr<c10::Half>()),
      bins.data_ptr<int32_t>(),
      reinterpret_cast<half *>(output.data_ptr<c10::Half>()), elements,
      hidden_size, top_k);
  return output;
}
