#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <c10/util/Half.h>

#define CHUNK_SIZE 4096
#define TASK_NUM 64

template <typename T>
__mlu_entry__ void leakyrelu_kernel(const T *input, T *output, int total,
                                    float negative_slope) {
  uint32_t core_id = taskId;
  uint32_t core_num = taskDim;
  uint32_t per_core = total / core_num;
  uint32_t remainder = total % core_num;

  uint32_t start = core_id * per_core + (core_id < remainder ? core_id : remainder);
  uint32_t count = per_core + (core_id < remainder ? 1 : 0);

  __nram__ T nram_input[CHUNK_SIZE];
  __nram__ T nram_mask[CHUNK_SIZE];
  __nram__ T nram_output[CHUNK_SIZE];

  for (uint32_t offset = 0; offset < count; offset += CHUNK_SIZE) {
    uint32_t len = (offset + CHUNK_SIZE <= count) ? CHUNK_SIZE : (count - offset);
    uint32_t aligned_len = (len + 63) & ~63;

    __memcpy(nram_input, input + start + offset, len * sizeof(T), GDRAM2NRAM);

    // scale = negative_slope + (1 - negative_slope) * (x >= 0)
    __bang_ge_scalar(nram_mask, nram_input, (T)0, aligned_len);
    __bang_mul_scalar(nram_mask, nram_mask, (T)(1.0f - negative_slope), aligned_len);
    __bang_add_scalar(nram_mask, nram_mask, (T)negative_slope, aligned_len);
    __bang_mul(nram_output, nram_input, nram_mask, aligned_len);

    __memcpy(output + start + offset, nram_output, len * sizeof(T), NRAM2GDRAM);
  }
}

torch::Tensor bang_func(torch::Tensor x, double negative_slope) {
  TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
  auto output = torch::empty_like(x);

  int total = static_cast<int>(x.numel());
  cnrtQueue_t queue = torch_mlu::getCurMLUStream();
  cnrtDim3_t dim = {TASK_NUM, 1, 1};
  cnrtFunctionType_t ktype = cnrtFuncTypeBlock;

  if (x.scalar_type() == torch::kHalf) {
    leakyrelu_kernel<<<dim, ktype, queue>>>(
        reinterpret_cast<const half *>(x.data_ptr<c10::Half>()),
        reinterpret_cast<half *>(output.data_ptr<c10::Half>()), total,
        static_cast<float>(negative_slope));
  } else {
    TORCH_CHECK(x.scalar_type() == torch::kFloat, "Only float16/float32 inputs are supported");
    leakyrelu_kernel<<<dim, ktype, queue>>>(
        x.data_ptr<float>(), output.data_ptr<float>(), total,
        static_cast<float>(negative_slope));
  }

  return output;
}
