#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <c10/util/Half.h>

#define ROWS 256
#define COLS 131072
#define CHUNK 4096

__mlu_entry__ void gemv_half_kernel(const half *A, const half *B, float *out,
                                    int rows, int cols) {
  int row = taskId;
  if (row >= rows) return;

  __nram__ half nram_a[CHUNK];
  __nram__ half nram_b[CHUNK];
  __nram__ float fa[CHUNK];
  __nram__ float fb[CHUNK];
  __nram__ float prod[CHUNK];

  float sum = 0.0f;
  float corr = 0.0f;
  for (int off = 0; off < cols; off += CHUNK) {
    int len = (off + CHUNK <= cols) ? CHUNK : (cols - off);
    int aligned = (len + 63) & ~63;
    __bang_write_value(nram_a, aligned, (half)0);
    __bang_write_value(nram_b, aligned, (half)0);
    __memcpy(nram_a, A + row * cols + off, len * sizeof(half), GDRAM2NRAM);
    __memcpy(nram_b, B + off, len * sizeof(half), GDRAM2NRAM);
    __bang_half2float(fa, nram_a, aligned);
    __bang_half2float(fb, nram_b, aligned);
    __bang_mul(prod, fa, fb, aligned);
    for (int i = 0; i < len; ++i) {
      float y = prod[i] - corr;
      float t = sum + y;
      corr = (t - sum) - y;
      sum = t;
    }
  }
  out[row] = sum;
}

torch::Tensor bang_func(torch::Tensor A, torch::Tensor B) {
  TORCH_CHECK(A.is_contiguous() && B.is_contiguous(), "Inputs must be contiguous");
  TORCH_CHECK(A.scalar_type() == torch::kHalf && B.scalar_type() == torch::kHalf,
              "Only float16 inputs are supported");
  int rows = static_cast<int>(A.size(0));
  int cols = static_cast<int>(A.size(1));
  auto output = torch::empty({rows, 1}, A.options().dtype(torch::kFloat));
  cnrtQueue_t queue = torch_mlu::getCurMLUStream();
  cnrtDim3_t grid = {static_cast<unsigned int>(rows), 1, 1};
  gemv_half_kernel<<<grid, cnrtFuncTypeBlock, queue>>>(
      reinterpret_cast<const half *>(A.data_ptr<c10::Half>()),
      reinterpret_cast<const half *>(B.data_ptr<c10::Half>()),
      output.data_ptr<float>(), rows, cols);
  return output;
}
