#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <c10/util/Half.h>
#include <cstdint>

__mlu_entry__ void scatter_add_half_kernel(const half *src, const int64_t *index,
                                           half *out, int N, int D,
                                           int dim_size) {
  if (taskId != 0) return;
  for (int i = 0; i < dim_size * D; ++i) {
    out[i] = (half)0;
  }
  for (int n = 0; n < N; ++n) {
    int dst_row = (int)index[n];
    for (int d = 0; d < D; ++d) {
      int dst = dst_row * D + d;
      out[dst] = (half)((float)out[dst] + (float)src[n * D + d]);
    }
  }
}

torch::Tensor bang_func(torch::Tensor src, torch::Tensor index, int dim_size) {
  TORCH_CHECK(src.is_contiguous() && index.is_contiguous(), "Inputs must be contiguous");
  TORCH_CHECK(src.scalar_type() == torch::kHalf, "Only float16 src is supported");
  int N = static_cast<int>(src.size(0));
  int D = static_cast<int>(src.size(1));
  auto output = torch::empty({dim_size, D}, src.options());
  cnrtQueue_t queue = torch_mlu::getCurMLUStream();
  cnrtDim3_t grid = {1, 1, 1};
  scatter_add_half_kernel<<<grid, cnrtFuncTypeBlock, queue>>>(
      reinterpret_cast<const half *>(src.data_ptr<c10::Half>()),
      index.data_ptr<int64_t>(),
      reinterpret_cast<half *>(output.data_ptr<c10::Half>()), N, D, dim_size);
  return output;
}
