#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <c10/util/Half.h>

#define BATCH 32
#define SEQ_LEN 128
#define INPUT_SIZE 256
#define HIDDEN_SIZE 512

__mlu_entry__ void gru_forward_half_kernel(
    const half *x,
    const half *weight_ih_l0, const half *weight_hh_l0,
    const half *bias_ih_l0, const half *bias_hh_l0,
    const half *weight_ih_l1, const half *weight_hh_l1,
    const half *bias_ih_l1, const half *bias_hh_l1,
    float *h0, float *h1, float *layer0_out, float *output, int batch,
    int seq_len, int input_size, int hidden_size) {
  if (taskId != 0) return;

  __nram__ float nram_scalar[64];

  for (int i = 0; i < batch * hidden_size; ++i) {
    h0[i] = 0.0f;
    h1[i] = 0.0f;
  }

  for (int t = 0; t < seq_len; ++t) {
    // Layer 0
    for (int b = 0; b < batch; ++b) {
      for (int h = 0; h < hidden_size; ++h) {
        float ir = (float)bias_ih_l0[h];
        float iz = (float)bias_ih_l0[hidden_size + h];
        float in = (float)bias_ih_l0[2 * hidden_size + h];
        float hr = (float)bias_hh_l0[h];
        float hz = (float)bias_hh_l0[hidden_size + h];
        float hn = (float)bias_hh_l0[2 * hidden_size + h];

        const int x_base = (b * seq_len + t) * input_size;
        for (int k = 0; k < input_size; ++k) {
          float xv = (float)x[x_base + k];
          ir += xv * (float)weight_ih_l0[h * input_size + k];
          iz += xv * (float)weight_ih_l0[(hidden_size + h) * input_size + k];
          in += xv * (float)weight_ih_l0[(2 * hidden_size + h) * input_size + k];
        }

        const int h_base = b * hidden_size;
        for (int k = 0; k < hidden_size; ++k) {
          float hv = h0[h_base + k];
          hr += hv * (float)weight_hh_l0[h * hidden_size + k];
          hz += hv * (float)weight_hh_l0[(hidden_size + h) * hidden_size + k];
          hn += hv * (float)weight_hh_l0[(2 * hidden_size + h) * hidden_size + k];
        }

        __bang_write_value(nram_scalar, 64, -(ir + hr));
        __bang_active_exphp(nram_scalar, nram_scalar, 64);
        float r = 1.0f / (1.0f + nram_scalar[0]);
        __bang_write_value(nram_scalar, 64, -(iz + hz));
        __bang_active_exphp(nram_scalar, nram_scalar, 64);
        float z = 1.0f / (1.0f + nram_scalar[0]);
        float n_pre = in + r * hn;
        __bang_write_value(nram_scalar, 64, -2.0f * n_pre);
        __bang_active_exphp(nram_scalar, nram_scalar, 64);
        float n = 2.0f / (1.0f + nram_scalar[0]) - 1.0f;
        float prev = h0[h_base + h];
        float ht = (1.0f - z) * n + z * prev;
        h0[h_base + h] = ht;
        layer0_out[h_base + h] = ht;
      }
    }

    // Layer 1
    for (int b = 0; b < batch; ++b) {
      for (int h = 0; h < hidden_size; ++h) {
        float ir = (float)bias_ih_l1[h];
        float iz = (float)bias_ih_l1[hidden_size + h];
        float in = (float)bias_ih_l1[2 * hidden_size + h];
        float hr = (float)bias_hh_l1[h];
        float hz = (float)bias_hh_l1[hidden_size + h];
        float hn = (float)bias_hh_l1[2 * hidden_size + h];

        const int h_base = b * hidden_size;
        for (int k = 0; k < hidden_size; ++k) {
          float xv = layer0_out[h_base + k];
          ir += xv * (float)weight_ih_l1[h * hidden_size + k];
          iz += xv * (float)weight_ih_l1[(hidden_size + h) * hidden_size + k];
          in += xv * (float)weight_ih_l1[(2 * hidden_size + h) * hidden_size + k];

          float hv = h1[h_base + k];
          hr += hv * (float)weight_hh_l1[h * hidden_size + k];
          hz += hv * (float)weight_hh_l1[(hidden_size + h) * hidden_size + k];
          hn += hv * (float)weight_hh_l1[(2 * hidden_size + h) * hidden_size + k];
        }

        __bang_write_value(nram_scalar, 64, -(ir + hr));
        __bang_active_exphp(nram_scalar, nram_scalar, 64);
        float r = 1.0f / (1.0f + nram_scalar[0]);
        __bang_write_value(nram_scalar, 64, -(iz + hz));
        __bang_active_exphp(nram_scalar, nram_scalar, 64);
        float z = 1.0f / (1.0f + nram_scalar[0]);
        float n_pre = in + r * hn;
        __bang_write_value(nram_scalar, 64, -2.0f * n_pre);
        __bang_active_exphp(nram_scalar, nram_scalar, 64);
        float n = 2.0f / (1.0f + nram_scalar[0]) - 1.0f;
        float prev = h1[h_base + h];
        float ht = (1.0f - z) * n + z * prev;
        h1[h_base + h] = ht;
        output[(b * seq_len + t) * hidden_size + h] = ht;
      }
    }
  }
}

torch::Tensor bang_func(
    torch::Tensor x,
    torch::Tensor weight_ih_l0, torch::Tensor weight_hh_l0,
    torch::Tensor bias_ih_l0, torch::Tensor bias_hh_l0,
    torch::Tensor weight_ih_l1, torch::Tensor weight_hh_l1,
    torch::Tensor bias_ih_l1, torch::Tensor bias_hh_l1,
    int input_size, int hidden_size, int num_layers) {
  TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
  TORCH_CHECK(weight_ih_l0.is_contiguous() && weight_hh_l0.is_contiguous() &&
                  bias_ih_l0.is_contiguous() && bias_hh_l0.is_contiguous() &&
                  weight_ih_l1.is_contiguous() && weight_hh_l1.is_contiguous() &&
                  bias_ih_l1.is_contiguous() && bias_hh_l1.is_contiguous(),
              "GRU weights must be contiguous");
  TORCH_CHECK(x.scalar_type() == torch::kHalf, "Only float16 input is supported");
  TORCH_CHECK(num_layers == 2, "Only the 2-layer GRU case is supported");

  int batch = static_cast<int>(x.size(0));
  int seq_len = static_cast<int>(x.size(1));
  auto output = torch::empty({batch, seq_len, hidden_size},
                             x.options().dtype(torch::kFloat));
  auto h0 = torch::empty({batch, hidden_size}, x.options().dtype(torch::kFloat));
  auto h1 = torch::empty({batch, hidden_size}, x.options().dtype(torch::kFloat));
  auto layer0_out = torch::empty({batch, hidden_size},
                                 x.options().dtype(torch::kFloat));

  cnrtQueue_t queue = torch_mlu::getCurMLUStream();
  cnrtDim3_t grid = {1, 1, 1};
  gru_forward_half_kernel<<<grid, cnrtFuncTypeBlock, queue>>>(
      reinterpret_cast<const half *>(x.data_ptr<c10::Half>()),
      reinterpret_cast<const half *>(weight_ih_l0.data_ptr<c10::Half>()),
      reinterpret_cast<const half *>(weight_hh_l0.data_ptr<c10::Half>()),
      reinterpret_cast<const half *>(bias_ih_l0.data_ptr<c10::Half>()),
      reinterpret_cast<const half *>(bias_hh_l0.data_ptr<c10::Half>()),
      reinterpret_cast<const half *>(weight_ih_l1.data_ptr<c10::Half>()),
      reinterpret_cast<const half *>(weight_hh_l1.data_ptr<c10::Half>()),
      reinterpret_cast<const half *>(bias_ih_l1.data_ptr<c10::Half>()),
      reinterpret_cast<const half *>(bias_hh_l1.data_ptr<c10::Half>()),
      h0.data_ptr<float>(), h1.data_ptr<float>(), layer0_out.data_ptr<float>(),
      output.data_ptr<float>(), batch, seq_len, input_size, hidden_size);
  return output;
}
