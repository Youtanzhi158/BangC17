#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <c10/util/Half.h>

#define TILE 16384
#define TASKS 16

__mlu_entry__ void softsign_half_kernel(half *x, int total) {
  int per_core = total / taskDim;
  int rem = total % taskDim;
  int start = taskId * per_core + (taskId < rem ? taskId : rem);
  int count = per_core + (taskId < rem ? 1 : 0);

  __nram__ half input[TILE];
  __nram__ half denom[TILE];
  __nram__ half output[TILE];
  __nram__ half work[TILE * 2];

  for (int offset = 0; offset < count; offset += TILE) {
    int len = count - offset;
    if (len > TILE) len = TILE;
    int aligned = (len + 63) & ~63;
    __memcpy(input, x + start + offset, len * sizeof(half), GDRAM2NRAM);
    __bang_abs(denom, input, aligned);
    __bang_add_scalar(denom, denom, (half)1.0f, aligned);
    __mluop_div(output, input, denom, work, 1, aligned);
    __memcpy(x + start + offset, output, len * sizeof(half), NRAM2GDRAM);
  }
}

torch::Tensor bang_func(torch::Tensor x) {
  TORCH_CHECK(x.is_contiguous() && x.scalar_type() == torch::kHalf,
              "Softsign expects contiguous float16 input");
  cnrtQueue_t queue = torch_mlu::getCurMLUStream();
  cnrtDim3_t grid = {TASKS, 1, 1};
  softsign_half_kernel<<<grid, cnrtFuncTypeBlock, queue>>>(
      reinterpret_cast<half *>(x.data_ptr<c10::Half>()),
      static_cast<int>(x.numel()));
  return x;
}
