#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <c10/util/Half.h>

#define CHUNK_SIZE 4096
#define TASK_NUM 64
#define LN2 0.6931471805599453f

__mlu_entry__ void kl_loss_half_kernel(const half *input_log_prob,
                                       const half *target_prob,
                                       float *partials,
                                       int total) {
  uint32_t core_id = taskId;
  uint32_t core_num = taskDim;
  uint32_t per_core = total / core_num;
  uint32_t remainder = total % core_num;
  uint32_t start = core_id * per_core + (core_id < remainder ? core_id : remainder);
  uint32_t count = per_core + (core_id < remainder ? 1 : 0);

  __nram__ half nram_input_h[CHUNK_SIZE];
  __nram__ half nram_target_h[CHUNK_SIZE];
  __nram__ float nram_input[CHUNK_SIZE];
  __nram__ float nram_target[CHUNK_SIZE];
  __nram__ float nram_reduce[CHUNK_SIZE];

  float local_sum = 0.0f;
  for (uint32_t offset = 0; offset < count; offset += CHUNK_SIZE) {
    uint32_t len = (offset + CHUNK_SIZE <= count) ? CHUNK_SIZE : (count - offset);
    uint32_t aligned_len = (len + 63) & ~63;

    __bang_write_value(nram_input_h, aligned_len, (half)0);
    __bang_write_value(nram_target_h, aligned_len, (half)1);
    __memcpy(nram_input_h, input_log_prob + start + offset, len * sizeof(half), GDRAM2NRAM);
    __memcpy(nram_target_h, target_prob + start + offset, len * sizeof(half), GDRAM2NRAM);

    __bang_half2float(nram_input, nram_input_h, aligned_len);
    __bang_half2float(nram_target, nram_target_h, aligned_len);
    __bang_log2(nram_reduce, nram_target, aligned_len);
    __bang_mul_scalar(nram_reduce, nram_reduce, LN2, aligned_len);
    __bang_sub(nram_reduce, nram_reduce, nram_input, aligned_len);
    __bang_mul(nram_reduce, nram_reduce, nram_target, aligned_len);
    for (uint32_t i = 0; i < len; ++i) {
      local_sum += nram_reduce[i];
    }
  }
  partials[core_id] = local_sum;
}

__mlu_entry__ void kl_loss_float_kernel(const float *input_log_prob,
                                        const float *target_prob,
                                        float *partials,
                                        int total) {
  uint32_t core_id = taskId;
  uint32_t core_num = taskDim;
  uint32_t per_core = total / core_num;
  uint32_t remainder = total % core_num;
  uint32_t start = core_id * per_core + (core_id < remainder ? core_id : remainder);
  uint32_t count = per_core + (core_id < remainder ? 1 : 0);

  __nram__ float nram_input[CHUNK_SIZE];
  __nram__ float nram_target[CHUNK_SIZE];
  __nram__ float nram_reduce[CHUNK_SIZE];

  float local_sum = 0.0f;
  for (uint32_t offset = 0; offset < count; offset += CHUNK_SIZE) {
    uint32_t len = (offset + CHUNK_SIZE <= count) ? CHUNK_SIZE : (count - offset);
    uint32_t aligned_len = (len + 63) & ~63;

    __bang_write_value(nram_input, aligned_len, 0.0f);
    __bang_write_value(nram_target, aligned_len, 1.0f);
    __memcpy(nram_input, input_log_prob + start + offset, len * sizeof(float), GDRAM2NRAM);
    __memcpy(nram_target, target_prob + start + offset, len * sizeof(float), GDRAM2NRAM);

    __bang_log2(nram_reduce, nram_target, aligned_len);
    __bang_mul_scalar(nram_reduce, nram_reduce, LN2, aligned_len);
    __bang_sub(nram_reduce, nram_reduce, nram_input, aligned_len);
    __bang_mul(nram_reduce, nram_reduce, nram_target, aligned_len);
    for (uint32_t i = 0; i < len; ++i) {
      local_sum += nram_reduce[i];
    }
  }
  partials[core_id] = local_sum;
}

__mlu_entry__ void finalize_batchmean_kernel(const float *partials, float *output,
                                             int batch_size) {
  __nram__ float nram_partials[TASK_NUM];
  __bang_write_value(nram_partials, TASK_NUM, 0.0f);
  __memcpy(nram_partials, partials, TASK_NUM * sizeof(float), GDRAM2NRAM);
  float sum = 0.0f;
  for (int i = 0; i < TASK_NUM; ++i) {
    sum += nram_partials[i];
  }
  output[0] = sum / (float)batch_size;
}

torch::Tensor bang_func(torch::Tensor input_log_prob, torch::Tensor target_prob) {
  TORCH_CHECK(input_log_prob.is_contiguous() && target_prob.is_contiguous(),
              "Inputs must be contiguous");
  TORCH_CHECK(input_log_prob.numel() == target_prob.numel(),
              "Inputs must have the same number of elements");

  int total = static_cast<int>(input_log_prob.numel());
  int batch_size = static_cast<int>(input_log_prob.size(0));
  auto partials = torch::empty({TASK_NUM}, input_log_prob.options().dtype(torch::kFloat));
  auto output = torch::empty({}, input_log_prob.options().dtype(torch::kFloat));

  cnrtQueue_t queue = torch_mlu::getCurMLUStream();
  cnrtDim3_t dim = {TASK_NUM, 1, 1};
  cnrtDim3_t one = {1, 1, 1};
  cnrtFunctionType_t ktype = cnrtFuncTypeBlock;

  if (input_log_prob.scalar_type() == torch::kHalf) {
    kl_loss_half_kernel<<<dim, ktype, queue>>>(
        reinterpret_cast<const half *>(input_log_prob.data_ptr<c10::Half>()),
        reinterpret_cast<const half *>(target_prob.data_ptr<c10::Half>()),
        partials.data_ptr<float>(), total);
  } else {
    TORCH_CHECK(input_log_prob.scalar_type() == torch::kFloat,
                "Only float16/float32 inputs are supported");
    kl_loss_float_kernel<<<dim, ktype, queue>>>(
        input_log_prob.data_ptr<float>(), target_prob.data_ptr<float>(),
        partials.data_ptr<float>(), total);
  }

  finalize_batchmean_kernel<<<one, ktype, queue>>>(partials.data_ptr<float>(),
                                                   output.data_ptr<float>(),
                                                   batch_size);
  return output;
}
