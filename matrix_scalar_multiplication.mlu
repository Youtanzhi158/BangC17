#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <c10/util/Half.h>

#define CHUNK_SIZE 4096
#define TASK_NUM 64

template <typename T>
__mlu_entry__ void matrix_scalar_mul_kernel(const T *input, T *output, int total,
                                            float scalar) {
  uint32_t core_id = taskId;
  uint32_t core_num = taskDim;
  uint32_t per_core = total / core_num;
  uint32_t remainder = total % core_num;

  uint32_t start = core_id * per_core + (core_id < remainder ? core_id : remainder);
  uint32_t count = per_core + (core_id < remainder ? 1 : 0);

  __nram__ T nram_input[CHUNK_SIZE];
  __nram__ T nram_output[CHUNK_SIZE];

  for (uint32_t offset = 0; offset < count; offset += CHUNK_SIZE) {
    uint32_t len = (offset + CHUNK_SIZE <= count) ? CHUNK_SIZE : (count - offset);
    uint32_t aligned_len = (len + 63) & ~63;

    __memcpy(nram_input, input + start + offset, len * sizeof(T), GDRAM2NRAM);
    __bang_mul_scalar(nram_output, nram_input, (T)scalar, aligned_len);
    __memcpy(output + start + offset, nram_output, len * sizeof(T), NRAM2GDRAM);
  }
}

torch::Tensor bang_func(torch::Tensor A, double s) {
  TORCH_CHECK(A.is_contiguous(), "Input must be contiguous");
  auto output = torch::empty_like(A);

  int total = static_cast<int>(A.numel());
  cnrtQueue_t queue = torch_mlu::getCurMLUStream();
  cnrtDim3_t dim = {TASK_NUM, 1, 1};
  cnrtFunctionType_t ktype = cnrtFuncTypeBlock;

  if (A.scalar_type() == torch::kHalf) {
    matrix_scalar_mul_kernel<<<dim, ktype, queue>>>(
        reinterpret_cast<const half *>(A.data_ptr<c10::Half>()),
        reinterpret_cast<half *>(output.data_ptr<c10::Half>()), total,
        static_cast<float>(s));
  } else {
    TORCH_CHECK(A.scalar_type() == torch::kFloat, "Only float16/float32 inputs are supported");
    matrix_scalar_mul_kernel<<<dim, ktype, queue>>>(
        A.data_ptr<float>(), output.data_ptr<float>(), total, static_cast<float>(s));
  }

  return output;
}
