#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <c10/util/Half.h>

#define TASK_NUM 256
#define TILE_W 256

__mlu_entry__ void conv_transpose2d_half_kernel(
    const half *x, const half *kernel, float *out, int total_tiles,
    int in_channels, int out_channels, int h_in, int w_in, int kernel_size,
    int stride, int padding, int output_padding, int groups, int h_out,
    int w_out, int kernel_out_first) {
  __nram__ half nram_x_h[TILE_W];
  __nram__ float nram_x[TILE_W];
  __nram__ float nram_out[TILE_W];

  int tiles_w = (w_out + TILE_W - 1) / TILE_W;
  int in_per_group = in_channels / groups;
  int out_per_group = out_channels / groups;

  for (int tile = taskId; tile < total_tiles; tile += taskDim) {
    int tw = tile % tiles_w;
    int tmp = tile / tiles_w;
    int oh = tmp % h_out;
    tmp /= h_out;
    int oc = tmp % out_channels;
    int b = tmp / out_channels;

    int ow_start = tw * TILE_W;
    int len = w_out - ow_start;
    if (len > TILE_W) len = TILE_W;
    int aligned_len = (len + 63) & ~63;

    int group = oc / out_per_group;
    int ic_begin = group * in_per_group;
    int ocg = oc % out_per_group;

    __bang_write_value(nram_out, aligned_len, 0.0f);
    for (int icg = 0; icg < in_per_group; ++icg) {
      int ic = ic_begin + icg;
      int x_channel_base = ((b * in_channels + ic) * h_in) * w_in;
      for (int kh = 0; kh < kernel_size; ++kh) {
        int ih_num = oh + padding - kh;
        if (ih_num % stride != 0) continue;
        int ih = ih_num / stride;
        if (ih < 0 || ih >= h_in) continue;
        int x_row_base = x_channel_base + ih * w_in;
        for (int kw = 0; kw < kernel_size; ++kw) {
          float kv = kernel_out_first
                         ? (float)kernel[((oc * in_per_group + icg) *
                                              kernel_size +
                                          kh) *
                                             kernel_size +
                                         kw]
                         : (float)kernel[((ic * out_per_group + ocg) *
                                              kernel_size +
                                          kh) *
                                             kernel_size +
                                         kw];
          int iw_start_num = ow_start + padding - kw;
          if (stride == 1 && iw_start_num >= 0 &&
              iw_start_num + len <= w_in) {
            __memcpy(nram_x_h, x + x_row_base + iw_start_num,
                     len * sizeof(half), GDRAM2NRAM);
          } else {
            for (int i = 0; i < aligned_len; ++i) {
              int iw_num = ow_start + i + padding - kw;
              int ok = (i < len && iw_num % stride == 0);
              int iw = ok ? (iw_num / stride) : -1;
              nram_x_h[i] = (ok && iw >= 0 && iw < w_in) ? x[x_row_base + iw]
                                                          : (half)0;
            }
          }
          __bang_half2float(nram_x, nram_x_h, aligned_len);
          __bang_mul_scalar(nram_x, nram_x, kv, aligned_len);
          __bang_add(nram_out, nram_out, nram_x, aligned_len);
        }
      }
    }

    __memcpy(out + ((b * out_channels + oc) * h_out + oh) * w_out + ow_start,
             nram_out, len * sizeof(float), NRAM2GDRAM);
  }
}

torch::Tensor bang_func(torch::Tensor x, torch::Tensor kernel, int in_channels,
                        int out_channels, int kernel_size, int stride = 1,
                        int padding = 0, int output_padding = 0, int groups = 1,
                        bool bias = false) {
  TORCH_CHECK(x.is_contiguous() && kernel.is_contiguous(),
              "Inputs must be contiguous");
  TORCH_CHECK(x.scalar_type() == torch::kHalf &&
                  kernel.scalar_type() == torch::kHalf,
              "Only float16 inputs are supported");
  int batch = static_cast<int>(x.size(0));
  int h_in = static_cast<int>(x.size(2));
  int w_in = static_cast<int>(x.size(3));
  int h_out = (h_in - 1) * stride - 2 * padding + kernel_size + output_padding;
  int w_out = (w_in - 1) * stride - 2 * padding + kernel_size + output_padding;

  int in_per_group = in_channels / groups;
  int out_per_group = out_channels / groups;
  bool pytorch_layout = (static_cast<int>(kernel.size(0)) == in_channels &&
                         static_cast<int>(kernel.size(1)) == out_per_group);
  int kernel_out_first =
      (!pytorch_layout && static_cast<int>(kernel.size(0)) == out_channels &&
       static_cast<int>(kernel.size(1)) == in_per_group);

  auto output = torch::empty({batch, out_channels, h_out, w_out},
                             x.options().dtype(torch::kFloat));
  int tiles_w = (w_out + TILE_W - 1) / TILE_W;
  int total_tiles = batch * out_channels * h_out * tiles_w;
  cnrtQueue_t queue = torch_mlu::getCurMLUStream();
  cnrtDim3_t grid = {TASK_NUM, 1, 1};
  conv_transpose2d_half_kernel<<<grid, cnrtFuncTypeBlock, queue>>>(
      reinterpret_cast<const half *>(x.data_ptr<c10::Half>()),
      reinterpret_cast<const half *>(kernel.data_ptr<c10::Half>()),
      output.data_ptr<float>(), total_tiles, in_channels, out_channels, h_in,
      w_in, kernel_size, stride, padding, output_padding, groups, h_out, w_out,
      kernel_out_first);
  return output;
}
