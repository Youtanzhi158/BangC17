#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <c10/util/Half.h>

#define TASK_NUM 64

__mlu_entry__ void conv_transpose2d_half_kernel(
    const half *x, const half *kernel, float *out, int total, int batch,
    int in_channels, int out_channels, int h_in, int w_in, int kernel_size,
    int stride, int padding, int output_padding, int groups, int h_out,
    int w_out, int kernel_out_first) {
  int in_per_group = in_channels / groups;
  int out_per_group = out_channels / groups;
  for (int idx = taskId; idx < total; idx += taskDim) {
    int ow = idx % w_out;
    int tmp = idx / w_out;
    int oh = tmp % h_out;
    tmp /= h_out;
    int oc = tmp % out_channels;
    int b = tmp / out_channels;
    int group = oc / out_per_group;
    int ic_begin = group * in_per_group;

    float sum = 0.0f;
    for (int icg = 0; icg < in_per_group; ++icg) {
      int ic = ic_begin + icg;
      for (int kh = 0; kh < kernel_size; ++kh) {
        int ih_num = oh + padding - kh;
        if (ih_num % stride != 0) continue;
        int ih = ih_num / stride;
        if (ih < 0 || ih >= h_in) continue;
        for (int kw = 0; kw < kernel_size; ++kw) {
          int iw_num = ow + padding - kw;
          if (iw_num % stride != 0) continue;
          int iw = iw_num / stride;
          if (iw < 0 || iw >= w_in) continue;
          float xv = (float)x[((b * in_channels + ic) * h_in + ih) * w_in + iw];
          float kv = kernel_out_first
                         ? (float)kernel[((oc * in_per_group + icg) *
                                              kernel_size +
                                          kh) *
                                             kernel_size +
                                         kw]
                         : (float)kernel[((ic * out_per_group +
                                           (oc % out_per_group)) *
                                              kernel_size +
                                          kh) *
                                             kernel_size +
                                         kw];
          sum += xv * kv;
        }
      }
    }
    out[idx] = sum;
  }
}

torch::Tensor bang_func(torch::Tensor x, torch::Tensor kernel, int in_channels,
                        int out_channels, int kernel_size, int stride = 1,
                        int padding = 0, int output_padding = 0, int groups = 1,
                        bool bias = false) {
  TORCH_CHECK(x.is_contiguous() && kernel.is_contiguous(), "Inputs must be contiguous");
  TORCH_CHECK(x.scalar_type() == torch::kHalf && kernel.scalar_type() == torch::kHalf,
              "Only float16 inputs are supported");
  int batch = static_cast<int>(x.size(0));
  int h_in = static_cast<int>(x.size(2));
  int w_in = static_cast<int>(x.size(3));
  int h_out = (h_in - 1) * stride - 2 * padding + kernel_size + output_padding;
  int w_out = (w_in - 1) * stride - 2 * padding + kernel_size + output_padding;
  int in_per_group = in_channels / groups;
  int out_per_group = out_channels / groups;
  bool pyTorch_layout = (static_cast<int>(kernel.size(0)) == in_channels &&
                         static_cast<int>(kernel.size(1)) == out_per_group);
  int kernel_out_first =
      (!pyTorch_layout && static_cast<int>(kernel.size(0)) == out_channels &&
       static_cast<int>(kernel.size(1)) == in_per_group);
  auto output = torch::empty({batch, out_channels, h_out, w_out},
                             x.options().dtype(torch::kFloat));
  int total = batch * out_channels * h_out * w_out;
  cnrtQueue_t queue = torch_mlu::getCurMLUStream();
  cnrtDim3_t grid = {TASK_NUM, 1, 1};
  conv_transpose2d_half_kernel<<<grid, cnrtFuncTypeBlock, queue>>>(
      reinterpret_cast<const half *>(x.data_ptr<c10::Half>()),
      reinterpret_cast<const half *>(kernel.data_ptr<c10::Half>()),
      output.data_ptr<float>(), total, batch,
      in_channels, out_channels, h_in, w_in, kernel_size, stride, padding,
      output_padding, groups, h_out, w_out, kernel_out_first);
  return output;
}
